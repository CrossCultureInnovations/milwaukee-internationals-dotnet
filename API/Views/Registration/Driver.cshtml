@using API.Interfaces
@using API.Utilities
@using DAL.Interfaces
@using Microsoft.AspNetCore.Hosting
@model Models.Entities.Driver
@inject IConfigLogic ConfigLogic
@inject IWebHostEnvironment Environment
@inject IHttpRequestUtilityBuilder RequestUtilityBuilder;

@{
    ViewBag.Title = "Edit Driver";
    Layout = "_Layout";
    var globalConfig = await ConfigLogic.ResolveGlobalConfig();
    var captchaEnabled = CapService.IsEnabled(globalConfig, Environment);
    var captchaEndpoint = CapService.TryBuildEndpoint(globalConfig, out var endpoint) ? endpoint.AbsoluteUri : null;
    var utility = RequestUtilityBuilder.For(Context);
}

<div class="text-center">
    <img class="img-responsive" src="~/images/tour-header.jpg" alt="background" />
</div>

<div class="container">
    <div class="page-header">
        <h3>Driver Registration</h3>
    </div>
    
    <br />
    
    @await Html.PartialAsync("SimpleAlertContent", ViewData)
    
    @using (Html.BeginForm("RegisterDriver", "Registration", FormMethod.Post, new { ng_controller = "driverRegistrationCtrl", wait_on_submit = "" }))
    {
        @(await Html.PartialAsync("DriverContent", Model, new ViewDataDictionary(ViewData) {{ "Type", "Save"}}))
        
        <div class="form-group" ng-init="agreeSms = true; agreeSms_val = agreeSms" style="margin-bottom: 3rem">
            <label style="max-width: 50rem; font-weight: 500">
                By submitting your number, you provide express written consent to receive SMS messages from Milwaukee Internationals (via Cross Culture Innovations LLC). Message frequency varies. Text STOP to opt out or HELP for support.
            </label>
            <toggle class="pull-right" ng-model="agreeSms" on="Agree" off="Disagree" onstyle="btn-primary" offstyle="btn-default" ng-change="agreeSms_val = agreeSms"></toggle>
        </div> 

        if (!utility.IsAuthenticated() && captchaEnabled)
        {
            <cap-widget required data-cap-api-endpoint="@captchaEndpoint"></cap-widget>
        }
        
        <input class="btn btn-primary" type="submit" value="Register" ng-disabled="!agreeSms" />
    }

    @if (!utility.IsAuthenticated() && captchaEnabled)
    {
        <script src="https://cdn.jsdelivr.net/npm/cap-widget@0.1.57" type="module" async defer></script>
    }
</div>