@model Models.Enums.EntitiesEnum
@using DAL.Interfaces
@using Models.Enums
@inject IConfigLogic ConfigLogic
@{
    ViewBag.Title = "Registration Complete";
    Layout = "_Layout";
    var globalConfig = await ConfigLogic.ResolveGlobalConfig();
}

<h2>Thank you for the registration!</h2>

<h4>You will receive a confirmation email shortly. You can also check your spam folder and mark us as safe sender for future communication.</h4>
<br/>

@if (Model == EntitiesEnum.Student)
{
    <h4>
        Follow us on <a href="https://www.facebook.com/Milwaukeeinternationals/">our Facebook page</a> for more information.
    </h4>
    @if (!string.IsNullOrEmpty(ViewBag.DisplayId as string))
    {
        <br/>
        <p class="text-muted small">Student number: <strong>@ViewBag.DisplayId</strong></p>
    }
}